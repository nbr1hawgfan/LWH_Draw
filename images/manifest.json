{
    "name": "LWH Draw",
    "short_name": "LWH Draw",
    "description": "Logistics Warehouse diagrams and floor plans (draw.io)",
    "icons": [
        {
            "src": "../favicon.ico",
            "type": "image/x-icon",
            "sizes": "16x16 32x32"
        },
        {
            "src": "icon-192.png",
            "type": "image/png",
            "sizes": "192x192"
        },
        {
            "src": "icon-512.png",
            "type": "image/png",
            "sizes": "512x512"
        },
        {
            "src": "icon-192-maskable.png",
            "type": "image/png",
            "sizes": "192x192",
            "purpose": "maskable"
        },
        {
            "src": "icon-512-maskable.png",
            "type": "image/png",
            "sizes": "512x512",
            "purpose": "maskable"
        }
    ],
    "theme_color": "#C41230",
    "background_color": "#FFFFFF",
    "display": "fullscreen",
    "start_url": "../index.html",
    "file_handlers": [
        {
            "action": "../index.html",
            "accept": {
                "application/vnd.jgraph.mxfile": [
                    ".drawio"
                ]
            },
            "launch_type": "multiple-clients"
        }
    ]
}